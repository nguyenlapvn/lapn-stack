# Baseline trước, rule cụ thể sau: trong .gitattributes dòng sau ghi đè dòng trước.
* text=auto

# Bash scripts MUST use LF line endings (chạy trên Linux). Ép kể cả khi dev trên Windows.
*.sh        text eol=lf
*.tpl       text eol=lf
*.conf      text eol=lf
bin/lapn    text eol=lf
install.sh  text eol=lf
VERSION     text eol=lf
*.json      text eol=lf
